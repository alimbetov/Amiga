# Copy to .env and replace before starting.
TTS_PORT=8765
TTS_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
TTS_ENGINE_VOICES_JSON={"kokoro":"af_heart","piper":"kk_KZ-iseke-x_low"}
TTS_MODEL_ALLOWED_HOSTS=your-trusted-model-server.example
TTS_MODEL_MIRROR_BUCKET=
TTS_MODEL_MIRROR_ENDPOINT=
TTS_MODEL_MIRROR_PREFIX=tts-models/sha256
TTS_MODEL_OFFLINE=0
TTS_MODEL_MIRROR_REQUIRED=0
TTS_MIN_FREE_MB=256
TTS_MEMORY_LIMIT=6g
TTS_STORAGE_PROFILES_JSON={}
TTS_STORAGE_ALLOWED_HOSTS=
# Mirror S3 credentials: AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY
# Provide via secret manager or local environment, never commit them.
